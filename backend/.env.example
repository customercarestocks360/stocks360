# --- Firebase Admin (server side) ---
FIREBASE_PROJECT_ID=stock360bitntech
# The whole Admin service account key, base64-encoded on ONE line. Set this and the server
# needs no key file at all — repo + .env is a complete handoff. Left blank here because this
# file is committed; the real value lives only in .env. To produce it:
#   python -c "import base64,sys;print(base64.b64encode(open(sys.argv[1],'rb').read()).decode())" secrets/firebase-admin.json
# Raw JSON also works if you would rather paste the object itself.
FIREBASE_SERVICE_ACCOUNT=
# Fallback, read only when FIREBASE_SERVICE_ACCOUNT above is empty: a path to the key file
# on disk, relative to backend/ or absolute.
FIREBASE_CREDENTIALS=secrets/firebase-admin.json
# Clock-drift tolerance when verifying ID tokens, in seconds (0-60).
# Too low and a server running behind Google rejects valid tokens as "used too early".
FIREBASE_CLOCK_SKEW_SECONDS=30

# How long a successful revocation check is trusted before Firebase is asked again (0-300).
# The signature check is local and costs <1ms; the revocation check is a round-trip to
# Google measured at ~384ms, paid by every protected request. Caching it per user makes
# the hot path ~0.6ms. Logout evicts the entry, so revocation is immediate on the process
# that handled it — behind a load balancer, other instances can lag by up to this TTL.
# Set 0 to check Firebase on every request (correct, and ~400x slower).
FIREBASE_REVOCATION_TTL_SECONDS=30

# --- Deployment posture ---
# Number of reverse proxies in front of this app. X-Forwarded-For is client-supplied and
# forgeable, and the resulting IP is written into the KYC consent record and login audit.
# 0 ignores the header entirely (correct when nothing fronts the app). Behind one proxy
# (nginx, Cloudflare, an ALB) set 1, and so on — the Nth address from the right is used.
TRUSTED_PROXY_HOPS=0

# Serve /docs, /redoc and /openapi.json. Leave on while building; turn OFF in production
# so the full route inventory and every input bound is not published.
DOCS_ENABLED=true

# Exact browser origins allowed to call this API, comma-separated, e.g.
# CORS_ALLOW_ORIGINS=https://app.stocks360.com,https://staging.stocks360.com
# Empty means no CORS middleware at all — same-origin only, which is the safe default.
# `*` is rejected at startup: this API is credentialed, so a wildcard would let any site
# call it with a signed-in user's token.
CORS_ALLOW_ORIGINS=

# --- Firebase Web SDK (client side, served to the browser via GET /auth/config) ---
# These are the values from the Firebase console web-app snippet. They are public by
# design (shipped to every browser) and are protected by authorized domains plus
# security rules, not by secrecy. The service account key is the real secret.
FIREBASE_API_KEY=AIzaSyCKmgg2O8yFG8kBOtJOd_6AkxiwTyzJFvc
FIREBASE_AUTH_DOMAIN=stock360bitntech.firebaseapp.com
FIREBASE_STORAGE_BUCKET=stock360bitntech.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=325724377164
FIREBASE_APP_ID=1:325724377164:web:b88c3d2f26dc3ed91924e9
FIREBASE_MEASUREMENT_ID=G-GT3ZZF1XWX

# --- MongoDB Atlas ---
# Real credential — keep out of version control.
MONGODB_URI="mongodb+srv://customercarestocks360_db_user:zyo4nZHCTYxI7EH2@cluster0.wdu9kyr.mongodb.net"
MONGODB_DB_NAME=stocks360

# --- Crypto market data (Binance public endpoints) ---
# Public market data only, so there is no API key or secret. Override the hosts to use a
# regional mirror (api1-api4.binance.com, api-gcp.binance.com) or the testnet.
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_TIMEOUT_SECONDS=10

# How long the tradable-symbol list is cached before refetching (60-86400).
CRYPTO_SYMBOLS_TTL_SECONDS=21600

# Per-user ceilings; each open socket costs an upstream subscription and a queue.
CRYPTO_MAX_WATCHLISTS=20
CRYPTO_MAX_SYMBOLS_PER_WATCHLIST=50
CRYPTO_MAX_SOCKETS_PER_USER=5

# Seconds of silence before the server sends a heartbeat frame (5-300).
CRYPTO_HEARTBEAT_SECONDS=20

# --- Forex market data (AwesomeAPI public endpoints) ---
# Public data only, so there is no API key or secret. This provider has no WebSocket, so
# the hub polls its batch endpoint — one request covers every subscribed pair.
FOREX_REST_URL=https://economia.awesomeapi.com.br
FOREX_TIMEOUT_SECONDS=10

# How long the supported-pair list is cached before refetching (60-86400).
FOREX_PAIRS_TTL_SECONDS=21600

# How often the hub polls for the subscribed pairs, in seconds (1-60).
FOREX_POLL_SECONDS=3

# A quote older than this is flagged stale. FX is 24/5, so every pair goes stale over a
# weekend — that is the market being shut, not a fault.
FOREX_STALE_SECONDS=180

FOREX_MAX_WATCHLISTS=20
FOREX_MAX_SYMBOLS_PER_WATCHLIST=30
FOREX_MAX_SOCKETS_PER_USER=5
FOREX_HEARTBEAT_SECONDS=20

# --- Equities / instruments (Yahoo Finance) ---
# Undocumented, unsanctioned endpoints: fine for development, not for real customers.
# Everything is isolated behind app/stocks/upstream.py so swapping to a licensed provider
# (Alpaca, Finnhub, or a broker API for NSE/BSE) is one file.
YAHOO_REST_URL=https://query1.finance.yahoo.com

# Yahoo refuses requests without a browser user agent — leave this set.
YAHOO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36
STOCKS_TIMEOUT_SECONDS=12

# How long a resolved instrument (name, exchange, currency) is cached (60-86400).
STOCKS_INSTRUMENT_TTL_SECONDS=3600

# There is no working unauthenticated batch quote, so a poll costs one request per
# distinct ticker. Poll gently and bound the burst.
STOCKS_POLL_SECONDS=15
STOCKS_POLL_CONCURRENCY=6

# Yahoo's free data is ~15 minutes delayed, so the staleness window is wider than a
# real-time feed's or every quote would look stale.
STOCKS_STALE_SECONDS=1800

STOCKS_MAX_WATCHLISTS=20
STOCKS_MAX_SYMBOLS_PER_WATCHLIST=25
STOCKS_MAX_SOCKETS_PER_USER=5
STOCKS_HEARTBEAT_SECONDS=20
